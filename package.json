{
  "name": "baladio-installer",
  "version": "1.0.0",
  "description": "Installer for Baladio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.baladio.installer",
    "productName": "Baladio Installer",
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  }
}
